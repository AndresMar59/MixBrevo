{
    "version": 2,
    "functions": {
        "Program.cs": {
            "runtime": "vercel-dotnet@0.6.1"
        }
    },
    "routes": [
        {
            "src": "/swagger/(.*)",
            "dest": "Program.cs"
        },
        {
            "src": "/api/(.*)",
            "dest": "Program.cs"
        },
        {
            "src": "/(.*)",
            "dest": "Program.cs"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/sync-cohorts",
            "schedule": "0 */6 * * *"
        }
    ]
}