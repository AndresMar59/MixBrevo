{
    "version": 2,
    "builds": [
        {
            "src": "*.csproj",
            "use": "vercel-dotnet",
            "config": { "maxDuration": 60 }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/"
        },
        {
            "src": "/swagger/(.*)",
            "dest": "/"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/sync-cohorts",
            "schedule": "0 */6 * * *"
        }
    ]
}