{
    "version": 2,
    "builds": [
        {
            "src": "MixBrev.csproj",
            "use": "vercel-dotnet"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "MixBrev.csproj"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/sync-cohorts",
            "schedule": "0 */6 * * *"
        }   ]
}