{
    "version": 2,
    "functions": {
        "*.cs": {
            "runtime": "vercel-dotnet@0.6.1"
        }
    },
    "routes": [
        {
            "src": "/swagger/(.*)",
            "dest": "/"
        },
        {
            "src": "/api/(.*)",
            "dest": "/"
        },
        {
            "src": "/(.*)",
            "dest": "/"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/sync-cohorts",
            "schedule": "0 */6 * * *"
        }
    ]
}